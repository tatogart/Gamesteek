rules_version = '2';

// Правила доступа к базе Gamesteek.
// Вставьте их в Firebase Console → Firestore Database → Rules и замените
// ВАШ_EMAIL@gmail.com на свой Google-аккаунт. Можно указать несколько адресов через запятую.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/{store}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ВАШ_EMAIL@gmail.com'];
    }
  }
}
